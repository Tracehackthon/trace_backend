{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.capability-publish@0.1.0",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_id", "protocol_version", "capability_id", "version", "display_name", "description", "artifact_kind", "source_root", "target_root", "host_compatibility", "runtime_compatibility", "dependencies", "provenance", "sources", "files", "installed_before", "staged_at"],
  "allOf": [
    {
      "if": {"properties": {"artifact_kind": {"const": "skill"}}},
      "then": {"required": ["content_contract"], "properties": {"provenance": {"required": ["capability_candidate_ref"]}}}
    }
  ],
  "properties": {
    "protocol_id": {"const": "trace.capability-publish"}, "protocol_version": {"const": "0.1.0"}, "capability_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "display_name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "artifact_kind": {"enum": ["skill", "workflow", "source-pack", "context-pack"]}, "source_root": {"type": "string", "minLength": 1}, "target_root": {"type": "string", "minLength": 1}, "host_compatibility": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "runtime_compatibility": {"type": "object", "additionalProperties": {"type": "string"}}, "dependencies": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}}, "provenance": {"$ref": "#/$defs/provenance"}, "content_contract": {"$ref": "trace.capability-content.0.1.schema.json"}, "protocol_registry_ref": {"type": "string"}, "sources": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "installed_before": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}, "staged_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "record_ref": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision", "kind", "schema_id", "schema_version"], "properties": {"record_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "kind": {"type": "string", "minLength": 1}, "schema_id": {"type": "string", "minLength": 1}, "schema_version": {"type": "string", "minLength": 1}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_kind", "source_refs", "change_id"], "properties": {"source_kind": {"enum": ["mywiki-cognitive-source", "mixed", "user-authored"]}, "source_refs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/record_ref"}}, "change_id": {"type": "string", "minLength": 1, "maxLength": 128}, "capability_candidate_ref": {"$ref": "#/$defs/record_ref"}, "source_revision": {"type": "string", "minLength": 1, "maxLength": 128}, "external_references": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["uri", "title", "observed_at"], "properties": {"uri": {"type": "string", "format": "uri", "maxLength": 2000}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "observed_at": {"type": "string", "format": "date-time"}}}}}}
  }
}
