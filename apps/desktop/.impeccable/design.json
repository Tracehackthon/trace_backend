  "components": [
    {
      "name": "Matters Primary Button",
      "kind": "button",
      "refersTo": "matters-button-primary",
      "description": "深度继续或确认材料关系的主操作；选中关系不表示已采用判断。",
      "html": "<button type=\"button\" class=\"ds-primary\">接为挑战</button>",
      "css": ".ds-primary{display:inline-flex;justify-content:center;align-items:center;gap:18px;min-height:49px;padding:10px 25px;border:0;border-radius:28px;font:400 22px/1.25 var(--matters-sans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif);white-space:nowrap;color:#f4fff9;background:linear-gradient(170deg,#126851,#004b38);box-shadow:inset 0 1px 1px #a9d6ad66,0 2px 4px #24472d15;cursor:pointer}.ds-primary:hover{background:linear-gradient(170deg,#1a775e,#055b43)}.ds-primary:focus-visible{outline:3px solid #126c53;outline-offset:5px}.ds-primary[aria-pressed=\"true\"]{box-shadow:0 0 0 2px #759c54,0 0 0 5px #ffffffa8}.ds-primary:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "Matters Secondary Button",
      "kind": "button",
      "refersTo": "matters-button-secondary",
      "description": "浅绿关系操作；次要外观不代表删除来源。",
      "html": "<button type=\"button\" class=\"ds-secondary\">这次无关</button>",
      "css": ".ds-secondary{display:inline-flex;justify-content:center;align-items:center;gap:18px;min-height:49px;padding:10px 25px;border:0;border-radius:28px;font:400 22px/1.25 var(--matters-sans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif);white-space:nowrap;color:#527c67;background:#ecf8df9e;box-shadow:inset 0 0 0 1px #d4e3c977;cursor:pointer}.ds-secondary:hover{background:#deefcccf}.ds-secondary:focus-visible{outline:3px solid #126c53;outline-offset:5px}.ds-secondary[aria-pressed=\"true\"]{box-shadow:0 0 0 2px #759c54,0 0 0 5px #ffffffa8}.ds-secondary:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "Matters Submit",
      "kind": "button",
      "refersTo": "matters-submit",
      "description": "composer 中的独立圆形提交；真实页面依据草稿是否为空启用。",
      "html": "<button type=\"button\" class=\"ds-submit\" aria-label=\"保存当前判断，回到总览\"><svg class=\"ds-arrow\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.45\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-submit{display:grid;place-items:center;flex:none;width:52px;height:52px;padding:0;border:0;border-radius:50%;background:#065e45;color:white;box-shadow:inset 0 1px 2px #97c28b88;cursor:pointer}.ds-submit:focus-visible{outline:3px solid #126c53;outline-offset:5px}.ds-submit:disabled{opacity:.43;cursor:default}.ds-arrow{width:25px;height:25px}"
    },
    {
      "name": "Matters Search",
      "kind": "input",
      "refersTo": "matters-search",
      "description": "总览搜索浅玻璃胶囊；静态片段不连接搜索模型，保留实现中输入自身 outline 为 0 的事实。",
      "html": "<div class=\"ds-search\"><svg class=\"ds-search-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.45\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6.5\"/><path d=\"m15 15 6 6\"/></svg><input class=\"ds-search-input\" type=\"search\" aria-label=\"找一下之前在意的事\" placeholder=\"找一下之前在意的事……\" /></div>",
      "css": ".ds-search{display:flex;align-items:center;gap:18px;box-sizing:border-box;width:626px;max-width:100%;height:66px;padding:0 24px;border:1.5px solid #ffffffeb;border-radius:42px;background:linear-gradient(180deg,#ffffffbe,#eff8f3a6);box-shadow:inset 0 2px 4px #ffffffb0,0 4px 20px #455f4920;color:#678579;backdrop-filter:blur(9px)}.ds-search-icon{width:27px;height:27px;flex:none}.ds-search-input{min-width:0;flex:1;height:100%;border:0;background:none;outline:0!important;font:400 24px var(--matters-sans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif);letter-spacing:.3px;color:#365c51}.ds-search-input::placeholder{color:#4b7062;opacity:1}.ds-search-input:focus-visible{outline:0!important}.ds-search-input::-webkit-search-cancel-button{display:none}"
    },
    {
      "name": "Matters Navigation",
      "kind": "nav",
      "description": "事项页右上角的同源 inline SVG 与透明文本操作；静态片段无路由副作用。",
      "html": "<nav class=\"ds-nav\" aria-label=\"页面导航\"><button type=\"button\" class=\"ds-nav-button\"><svg class=\"ds-search-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.45\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6.5\"/><path d=\"m15 15 6 6\"/></svg>搜索</button><span class=\"ds-divider\" aria-hidden=\"true\">|</span><button type=\"button\" class=\"ds-nav-button\"><svg class=\"ds-nav-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.45\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5\"/></svg>全部痕迹</button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:20px;font:400 19px var(--matters-sans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif);color:#45615c}.ds-nav-button{display:inline-flex;align-items:center;gap:10px;padding:6px 3px;border:0;background:transparent;white-space:nowrap;font:inherit;color:inherit;cursor:pointer}.ds-nav-button:hover{color:#063c2f;text-decoration:underline;text-underline-offset:5px}.ds-nav-button:focus-visible{outline:3px solid #126c53;outline-offset:5px}.ds-nav-icon,.ds-search-icon{display:block;width:24px;height:24px}.ds-divider{color:#91aaa1;opacity:.65;font-size:17px}"
    },
    {
      "name": "Matters Change Badge",
      "kind": "chip",
      "refersTo": "matters-change-badge",
      "description": "对象明确变化后的非交互徽记；不单独触发状态修改。",
      "html": "<span class=\"ds-change-badge\">刚有变化</span>",
      "css": ".ds-change-badge{display:inline-block;white-space:nowrap;font:400 15px/1.3 var(--matters-sans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif);letter-spacing:.4px;padding:4px 7px;border:1px solid #e7d88ab0;border-radius:10px;background:#fff3b652;color:#898050}"
    },
    {
      "name": "Matters Search Panel",
      "kind": "card",
      "refersTo": "matters-search-panel",
      "description": "规整的可滚动结果表面；示例行不是另一份事项状态。",
      "html": "<section class=\"ds-search-panel\" tabindex=\"0\" aria-label=\"搜索结果\"><h2 class=\"ds-group-title\">在意的事</h2><button type=\"button\" class=\"ds-result\"><span class=\"ds-result-title\">收藏后为什么接不回来</span><span class=\"ds-result-stop\">现在停在：重新出现的理由，可能比分类更重要</span></button></section>",
      "css": ".ds-search-panel{padding:27px 38px 33px;border:1.5px solid #ffffffdc;border-radius:35px;background:linear-gradient(150deg,#fafffbeb,#eaf3edda);box-shadow:inset 0 1px 3px #fff,0 5px 16px #49745d13;backdrop-filter:blur(13px);overflow:auto;scrollbar-width:thin;scrollbar-color:#9ab3a681 transparent;font-family:var(--matters-sans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif)}.ds-search-panel:focus-visible,.ds-result:focus-visible{outline:3px solid #126c53;outline-offset:5px}.ds-group-title{margin:0 0 10px;font:600 27px/1.5 var(--matters-serif,\"Noto Serif SC\",\"Songti SC\",\"SimSun\",serif);color:#365747}.ds-result{display:flex;flex-direction:column;gap:7px;width:100%;padding:12px 24px;text-align:left;border:0;border-radius:12px;background:linear-gradient(90deg,#edf6e9b0,#e4efdda1);color:#3e5b50;cursor:pointer}.ds-result:hover{background:#e4f1ded0}.ds-result-title{font:600 27px/1.5 var(--matters-serif,\"Noto Serif SC\",\"Songti SC\",\"SimSun\",serif);color:#325445}.ds-result-stop{font:400 19px/1.55 var(--matters-sans,\"Microsoft YaHei\",\"PingFang SC\",sans-serif);color:#506f59;overflow-wrap:anywhere}"
    },
    {
      "name": "Matters Irregular Glass",
      "kind": "custom",
      "description": "实际基础轮廓的静态 SVG 薄膜片段；不模拟环境折射采样，不替代原场景的复杂玻璃。",
      "html": "<div class=\"ds-glass\"><svg class=\"ds-glass-svg\" viewBox=\"0 0 1000 300\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><defs><linearGradient id=\"ds-bubble-fill\" x1=\"0\" y1=\"0\" x2=\".2\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#fff\" stop-opacity=\".85\"/><stop offset=\"34%\" stop-color=\"#f5fffd\" stop-opacity=\".73\"/><stop offset=\"77%\" stop-color=\"#dcefe9\" stop-opacity=\".43\"/><stop offset=\"100%\" stop-color=\"#fff\" stop-opacity=\".78\"/></linearGradient><linearGradient id=\"ds-bubble-rim\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0%\" stop-color=\"#fff\"/><stop offset=\"40%\" stop-color=\"#fff\" stop-opacity=\".87\"/><stop offset=\"65%\" stop-color=\"#9cbbb0\" stop-opacity=\".50\"/><stop offset=\"82%\" stop-color=\"#e6c46f\" stop-opacity=\".80\"/><stop offset=\"100%\" stop-color=\"#fff\" stop-opacity=\".98\"/></linearGradient></defs><path d=\"M 90 20 C 224 -3 366 18 489 13 C 655 4 789 8 906 32 C 974 46 1002 85 991 153 C 1008 217 964 269 891 278 C 675 302 576 277 446 287 C 309 303 188 290 102 273 C 27 260 7 219 14 153 C 0 91 19 39 90 20 Z\" fill=\"url(#ds-bubble-fill)\" stroke=\"url(#ds-bubble-rim)\" stroke-width=\"3.3\" vector-effect=\"non-scaling-stroke\"/><path d=\"M 90 20 C 224 -3 366 18 489 13 C 655 4 789 8 906 32 C 974 46 1002 85 991 153 C 1008 217 964 269 891 278 C 675 302 576 277 446 287 C 309 303 188 290 102 273 C 27 260 7 219 14 153 C 0 91 19 39 90 20 Z\" fill=\"none\" stroke=\"#fff\" stroke-opacity=\".65\" stroke-width=\"1\" transform=\"translate(7 4) scale(.985 .969)\" vector-effect=\"non-scaling-stroke\"/></svg><span class=\"ds-glass-copy\">上次真正停在</span></div>",
      "css": ".ds-glass{position:relative;display:grid;place-items:center;width:557px;max-width:100%;height:148px;color:#08251f;font:600 28px/1.34 var(--matters-serif,\"Noto Serif SC\",\"Songti SC\",\"SimSun\",serif);filter:drop-shadow(0 4px 6px #385e461c)}.ds-glass-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}.ds-glass-copy{position:relative;padding:16px 28px}"
    }
  ],
  "narrative": {
    "northStar": "同一个场景中的接续",
    "overview": "Mode: **Operate**。本文供维护桌面 Web的工程师与 Agent 使用，记录当前实现，而非提出新的视觉方向。山水、雾、水面、岩石与光构成连续环境；内容由真正可操作的文字、图标、输入与异形玻璃承载。层级来自对象位置、停点、聚焦和变化，不来自一套默认仪表盘组件。\n\n首页和“在意的事”共享场景语言，但保留各自构图权威。首页的六态仍属于同一首页场景；新增事项表面是独立的七图链路，不用首页参考覆盖它，也不反向重定义首页。",
