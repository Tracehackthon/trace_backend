{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.capability-candidate@0.2.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["candidate_id", "capability_id", "claim", "rationale", "semantic_delta", "judgment_change", "mechanism", "scope", "counterexamples", "activation_contract", "input_contract", "output_contract", "acceptance_contract", "evidence_record_ids", "precedent_record_ids", "adoption_status", "protocol_id", "protocol_version"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "capability_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "claim": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "semantic_delta": {"$ref": "#/$defs/semantic_delta"},
    "judgment_change": {"$ref": "#/$defs/judgment_change"},
    "mechanism": {"$ref": "#/$defs/mechanism"},
    "scope": {"$ref": "#/$defs/scope"},
    "counterexamples": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "activation_contract": {"$ref": "#/$defs/activation_contract"},
    "input_contract": {"$ref": "#/$defs/input_contract"},
    "output_contract": {"$ref": "#/$defs/output_contract"},
    "acceptance_contract": {"$ref": "#/$defs/acceptance_contract"},
    "evidence_record_ids": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
    "precedent_record_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1}},
    "adoption_status": {"enum": ["pending", "adopted", "rejected", "superseded"]},
    "protocol_id": {"const": "trace.capability-candidate"},
    "protocol_version": {"const": "0.2.0"}
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "optional_strings": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "semantic_delta": {"type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": {"before": {"type": "string", "minLength": 1}, "after": {"type": "string", "minLength": 1}}},
    "judgment_change": {"type": "object", "additionalProperties": false, "required": ["claim", "reason", "confidence"], "properties": {"claim": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "confidence": {"enum": ["low", "medium", "high"]}}},
    "mechanism": {"type": "object", "additionalProperties": false, "required": ["problem", "cause", "failure_modes"], "properties": {"problem": {"type": "string", "minLength": 1}, "cause": {"type": "string", "minLength": 1}, "failure_modes": {"$ref": "#/$defs/strings"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["applies_to", "does_not_apply_to"], "properties": {"applies_to": {"$ref": "#/$defs/strings"}, "does_not_apply_to": {"$ref": "#/$defs/optional_strings"}}},
    "activation_contract": {"type": "object", "additionalProperties": false, "required": ["triggers", "required_context", "forbidden_context"], "properties": {"triggers": {"$ref": "#/$defs/strings"}, "required_context": {"$ref": "#/$defs/strings"}, "forbidden_context": {"$ref": "#/$defs/optional_strings"}}},
    "input_contract": {"type": "object", "additionalProperties": false, "required": ["required", "optional"], "properties": {"required": {"$ref": "#/$defs/strings"}, "optional": {"$ref": "#/$defs/optional_strings"}}},
    "output_contract": {"type": "object", "additionalProperties": false, "required": ["artifacts", "user_visible"], "properties": {"artifacts": {"$ref": "#/$defs/strings"}, "user_visible": {"$ref": "#/$defs/strings"}}},
    "acceptance_contract": {"type": "object", "additionalProperties": false, "required": ["structural", "behavioral", "user_visible"], "properties": {"structural": {"$ref": "#/$defs/strings"}, "behavioral": {"$ref": "#/$defs/strings"}, "user_visible": {"$ref": "#/$defs/strings"}}}
  }
}
