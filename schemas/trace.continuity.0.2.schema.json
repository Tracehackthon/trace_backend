{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.continuity@0.2.0",
  "title": "Trace Continuity Envelope v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "protocol_version", "record_id", "revision", "kind", "thread_id", "correlation_id", "causation_id", "visibility", "payload", "created_at", "updated_at"],
  "properties": {
    "protocol_id": {"const": "trace.continuity"},
    "protocol_version": {"const": "0.2.0"},
    "record_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["thread", "discussion_turn", "persistence_receipt", "activation_receipt"]},
    "thread_id": {"type": "string"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "string", "minLength": 1},
    "visibility": {"enum": ["summary", "evidence", "audit"]},
    "payload": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
